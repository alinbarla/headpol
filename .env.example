# Public site URL used for canonical URLs, hreflang, sitemap, robots and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://stralkastarpolering.se

# Supabase (bookings)
# Dashboard → Project Settings → API. The URL and anon key are the "Project URL"
# and the public/anon key; both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Required, and secret. Same page, "service_role" key (Reveal to copy). It
# bypasses RLS, so it must never be exposed to the browser or committed. The
# admin, the Stripe webhook and cron write to tables whose RLS has no policies,
# so the anon key cannot reach them.
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP for booking confirmation (client) and owner alert.
# Use a Google App Password, not your normal Gmail password:
# Google Account → Security → 2-Step Verification → App passwords
# On Vercel, set the same keys under Project → Settings → Environment Variables
# (Production + Preview). NEXT_PUBLIC_* must exist at build time.
GMAIL_USER=teo@stralkastarpolering.se
GMAIL_APP_PASSWORD=

# --- Admin (admin.stralkastarpolering.se) ---------------------------------
# The host the admin is served on. Add it as a domain on the same Vercel
# project. Defaults to admin.localhost in development.
ADMIN_HOST=admin.stralkastarpolering.se
# At least 6 digits. Compared in constant time; five failed attempts from one
# IP lock logins for 15 minutes.
ADMIN_PIN=
# At least 32 characters, used to sign the admin session cookie. You invent it —
# no service issues it. Any long random string works; changing it logs everyone
# out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
ADMIN_SESSION_SECRET=

# --- Stripe ---------------------------------------------------------------
# Dashboard → Developers → API keys → Secret key (sk_live_… / sk_test_…).
# Web bookings are prepaid, so without this key the public booking form returns
# PAYMENTS_UNAVAILABLE. Enable card and Swish under Settings → Payment methods
# rather than in code; Swish requires requesting access from Stripe first.
STRIPE_SECRET_KEY=
# Dashboard → Developers → Webhooks → Add endpoint.
#   URL:    https://stralkastarpolering.se/api/stripe/webhook
#   Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           checkout.session.async_payment_failed, checkout.session.expired,
#           charge.refunded, refund.updated, refund.failed
# Do NOT point the endpoint at the site root — Stripe will disable it after
# repeated failures. Admin → Settings → "Repair webhook endpoint" can fix the
# URL and re-enable a disabled endpoint while keeping the same signing secret.
# The signing secret (whsec_…) is shown on the endpoint page after you create
# it. Test mode and live mode have separate endpoints and separate secrets.
STRIPE_WEBHOOK_SECRET=
# Optional. The Checkout line item points at these Dashboard products so the
# name and description are already in the customer's language. Defaults to the
# live products in lib/stripe.ts; override to use test-mode products.
STRIPE_PRODUCT_ID_SV=
STRIPE_PRODUCT_ID_EN=

# --- Cron -----------------------------------------------------------------
# You invent this one too. Vercel sends it as `Authorization: Bearer $CRON_SECRET`
# and the cron routes refuse to run without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Vercel Hobby allows two cron jobs, each running at most once a day, so
# vercel.json registers only /api/cron/reminders and /api/cron/complete-past.
# /api/cron/release-holds exists but is unscheduled; expired holds are cleared
# opportunistically by GET /api/bookings, by the insert conflict path and by
# Stripe's checkout.session.expired webhook.
CRON_SECRET=

# --- SEO tools (admin) ----------------------------------------------------
# DataForSEO API login + password from app.dataforseo.com → API credentials.
# Used for Backlinks, SERP, Keyword Data, Domain Analytics, Labs, OnPage,
# Content Analysis, AI Optimization, Business Data and Billing.
# Never commit real values. Tools no-op if these are unset.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional. Google PageSpeed Insights API key. The pagespeed tool skips if empty.
PAGESPEED_API_KEY=

# --- Google Places (homepage reviews) ------------------------------------
# Server-only. Do not prefix with NEXT_PUBLIC_. Restrict the key to Places API
# (New) only. Do not use HTTP referrer restriction — the fetch runs on the
# server, so a referrer lock returns 403.
GOOGLE_PLACES_API_KEY=
# Place ID for the live Google Business Profile (Place ID Finder).
GOOGLE_PLACE_ID=

# --- Admin assistant ------------------------------------------------------
# Moonshot API key for /admin/assistant. Server-only. The chat saves a skipped
# reply if this is empty. Optional model override defaults to kimi-k3.
MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k3
