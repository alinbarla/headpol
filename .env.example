# Public site URL used for canonical URLs, hreflang, sitemap, robots and Open Graph.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://stralkastpolering.se

# Supabase (bookings)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional: server-only service role key (preferred for the bookings API route)
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP for booking confirmation (client) and owner alert.
# Use a Google App Password, not your normal Gmail password:
# Google Account → Security → 2-Step Verification → App passwords
GMAIL_USER=teo@stralkastpolering.se
GMAIL_APP_PASSWORD=
